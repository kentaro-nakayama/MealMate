{
    "services": {
        "frontend": {
            "root": "frontend",
            "rewrites": [
                {
                    "source": "/(.*)",
                    "destination": "/index.html"
                }
            ]
        },
        "backend": {
            "root": "backend",
            "entrypoint": "debug_app:app"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": { "service": "backend" }
        },
        {
            "source": "/(.*)",
            "destination": { "service": "frontend" }
        }
    ]
}
